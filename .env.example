# Secretos solo del servidor; nunca usar prefijos VITE_.
# La demo no necesita OddsPapi.
ODDSPAPI_API_KEY=

# Obligatorios para EDITAR en Vercel y con npm start; consultar no requiere contraseña.
# public = consulta abierta + edición protegida. private = acceso completo protegido.
ACCESS_MODE=public
# APP_PASSWORD: contraseña aleatoria de al menos 16 caracteres.
# SESSION_SECRET: valor aleatorio diferente, de al menos 32 caracteres.
APP_PASSWORD=
SESSION_SECRET=

# Vercel lo crea al conectar Blob PRIVADO al proyecto. No se usa en Node/local.
BLOB_READ_WRITE_TOKEN=

# Solo Node/local. El disco debe ser persistente si se aloja en otro servidor.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Solo detrás de un proxy HTTPS: origen exacto, sin barra final. No se necesita en Vercel.
PUBLIC_ORIGIN=
